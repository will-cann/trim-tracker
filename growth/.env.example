# NeuroCann growth server. Copy to .env for local dev. On Railway, set these as service variables.

# Railway Postgres (use ${{Postgres.DATABASE_URL}} reference on Railway)
DATABASE_URL=postgresql://growth:growth@localhost/growth
PORT=8787

# Bearer keys for /mcp and the CLI (comma-separated; generate with `openssl rand -hex 32`)
GROWTH_API_KEYS=dev-key
# Salt for hashing visitor IPs (rate limiting only)
IP_HASH_SALT=change-me

# SendGrid. 'stub' logs emails instead of sending.
SENDGRID_API_KEY=stub
SENDGRID_FROM_EMAIL=hello@neurocann.app
# Who gets new demo request alerts and the daily digest
DEMO_NOTIFY_EMAIL=will@neurocann.app
# Cal.com / Calendly link offered after the form (prefilled with name + email). Unset = "we'll reply".
DEMO_SCHEDULING_URL=

# Attio (Settings → Developers → Access tokens; scopes: record read/write, object config read,
# list entry read/write, list config read, note read/write). Unset = sync skipped.
ATTIO_API_KEY=
# Slug of the Attio list demo requests are added to (a list on Companies). Unset = no list entries.
ATTIO_DEMO_LIST=

# Claude research enrichment. Unset = skipped.
ANTHROPIC_API_KEY=
ENRICH_MODEL=claude-opus-5-5

# State license registries on Socrata portals, JSON array. See README → License sources.
LICENSE_SOURCES=

# Set to false to run HTTP only. Graphile Worker is safe to run in several replicas if you scale out.
RUN_WORKER=true

# CLI only
GROWTH_URL=http://localhost:8787
GROWTH_API_KEY=dev-key
