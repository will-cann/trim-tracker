# Auth0 Frontend Configuration
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://api.trimtracker.com

# Auth0 Backend Configuration (Netlify Functions)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.trimtracker.com

# Database Configuration
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Anthropic API (for AI chat)
ANTHROPIC_API_KEY=sk-ant-...

# Deepgram (for voice/speech-to-text)
DEEPGRAM_API_KEY=your-deepgram-key

# Sentry (error monitoring)
SENTRY_DSN=https://your-dsn@sentry.io/your-project-id

# Dev bypass (set to true to skip Auth0 in local development)
# VITE_DEV_BYPASS_AUTH=true
# DEV_BYPASS_AUTH=true
