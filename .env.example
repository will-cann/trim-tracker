# Auth0 Frontend Configuration
VITE_AUTH0_DOMAIN=login.neurocann.app
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://api.neurocann.app

# Auth0 Backend Configuration (Netlify Functions)
AUTH0_DOMAIN=login.neurocann.app
AUTH0_AUDIENCE=https://api.neurocann.app

# Auth0 Management API (M2M app — for user invitations)
AUTH0_MGMT_CLIENT_ID=your-m2m-client-id
AUTH0_MGMT_CLIENT_SECRET=your-m2m-client-secret

# Database Configuration
# DATABASE_URL is the local dev connection — point it at the Neon `dev` branch, never prod.
# Prod credentials live in Netlify env vars (NETLIFY_DATABASE_URL, auto-managed by the Neon
# integration) and must never be pasted into this file. For ad-hoc prod migrations, create
# .env.production.local (gitignored) with the prod URL and run `node scripts/run-migration.mjs --prod`.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Anthropic API (for AI chat)
ANTHROPIC_API_KEY=sk-ant-...

# Deepgram (for voice/speech-to-text)
DEEPGRAM_API_KEY=your-deepgram-key

# Sentry (error monitoring)
SENTRY_DSN=https://your-dsn@sentry.io/your-project-id

# SendGrid (outbound email: invites + supplier outreach)
# Set to 'stub' to log emails instead of sending — required for tests.
SENDGRID_API_KEY=stub
SENDGRID_FROM_EMAIL=invites@neurocann.app
SENDGRID_FROM_NAME=neurocann
# From-address for AI-composed supplier outreach emails. Separate from invites@ so
# inbox deliverability is scoped per use case.
SENDGRID_OUTREACH_FROM=outreach@neurocann.app
# SendGrid Inbound Parse (vendor reply handling — see docs/sendgrid-inbound-setup.md).
# Subdomain MX'd to SendGrid; becomes the "replies" address on outbound threads
# (thread-<uuid>@<domain>) so replies route back through receive-email.
SENDGRID_INBOUND_DOMAIN=replies.neurocann.app
# ECDSA public key (PEM) from SendGrid Parse "Signed Event Webhook" settings.
# Leave blank in dev to skip signature verification (receive-email accepts unsigned).
SENDGRID_WEBHOOK_PUBLIC_KEY=

# Dev auth bypass (DEV_BYPASS_AUTH=true / VITE_DEV_BYPASS_AUTH=true) acts as the seed admin in
# the seed company. To work on the UI against another tenant's data on a dev database (a Neon
# branch copied from production), point it at that company and one of its users:
# DEV_BYPASS_COMPANY_ID=
# DEV_BYPASS_USER_ID=

# Manifest picker (/manifest) — signs in with the same Auth0 app as the main UI.
# Comma-separated company UUIDs allowed to use the picker's functions (email export,
# invoice reading, Metrc checks). Required because Auth0 signups auto-provision a
# company. Unset = picker functions disabled (403). DEV_BYPASS_AUTH=true skips it.
MANIFEST_COMPANY_IDS=
# Optional label shown on the picker's sign-in screen and Settings, e.g. "Proper Cannabis",
# so a per-customer deploy (see docs/manifest-t3.md) is recognisable.
VITE_MANIFEST_DEPLOY_NAME=

# Metrc via T3 (Track & Trace Tools API) for the manifest picker — see docs/manifest-t3.md.
# Secret key generated at https://api.trackandtrace.tools/v2/pages/secret-key with the Metrc
# login that owns the facility licences. It carries that login's full Metrc permissions, so it
# lives only here (server), never in the browser. Unset = Metrc checks disabled in the picker.
T3_API_KEY=
# With MANIFEST_COMPANY_IDS naming exactly one company, the same key also drives the
# Metrc → NeuroCann sync (items, strains, locations, packages every 15 minutes) into that
# company — docs/metrc-sync.md. Locally, Sync now needs `netlify dev` so the background
# function URL (process.env.URL) resolves.
# read-only (default): look up packages and validate transfers, never submit.
# sandbox: every call is swapped for a Metrc sandbox session (needs Metrc sandbox provisioning).
# live: real transfer submission after the user confirms.
T3_MODE=read-only

# LLM plugin (MCP server at /mcp) — see docs/llm-plugin.md.
# Canonical resource identifier that OAuth clients (ChatGPT, claude.ai) request tokens
# for. Must exactly equal the Auth0 API identifier created for the MCP server.
# Defaults to https://<request host>/mcp; set explicitly when behind a proxy/CDN.
MCP_RESOURCE=https://neurocann.app/mcp
# Public marketing/sign-in URL and contact surfaced by the no-login tools.
APP_PUBLIC_URL=https://neurocann.app
APP_CONTACT_EMAIL=will@neurocann.app

# Dev bypass (set to true to skip Auth0 in local development)
# VITE_DEV_BYPASS_AUTH=true
# DEV_BYPASS_AUTH=true

# Growth server dev proxy target for /api/growth/* (see growth/README.md). Defaults to http://localhost:8787.
# GROWTH_DEV_URL=http://localhost:8787
